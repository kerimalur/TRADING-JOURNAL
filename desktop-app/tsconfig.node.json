{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules"]
}
